{
  "name": "feed-reader",
  "version": "0.0.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "test": "bun test packages/ apps/",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "dev": "bun run scripts/dev.ts",
    "seed": "bun run scripts/seed.ts",
    "seed:reset": "bun run scripts/seed.ts --reset",
    "reingest": "bun run scripts/reingest.ts",
    "e2e": "bunx playwright test",
    "e2e:ui": "bunx playwright test --ui",
    "catalog": "bun run e2e/catalog/generate.ts",
    "docs:api": "bunx typedoc@0.28.20",
    "docs:site": "bun run scripts/build-docs-site.ts",
    "docs": "bun run catalog && bun run docs:api && bun run docs:site"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.62.1",
    "bun-types": "^1.3.14",
    "typescript": "7.0.2"
  }
}
