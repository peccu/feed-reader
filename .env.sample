# Copy to .env and fill in. Bun auto-loads .env for `bun run dev`.
# (.env is gitignored; this sample is committed.)

# Jina AI embeddings (free tier). Required for scoring / vector search.
# Get a key at https://jina.ai/embeddings
JINA_API_KEY=

# Claude CLI OAuth token for the claude-worker (article summarize/chat/analyze).
# Obtain via the Claude CLI login; used instead of an API key.
CLAUDE_CODE_OAUTH_TOKEN=

# --- Optional (have sensible defaults) ---
# SQLite DB path. Dev defaults to apps/app/feed-reader.db; Docker sets /data/db/feed-reader.db.
# DB_PATH=

# claude-worker URL (dev default http://localhost:3001).
# CLAUDE_WORKER_URL=

# Ingester intervals (defaults shown).
# RSS_POLL_INTERVAL_MINUTES=60
# PENDING_JOB_CHECK_INTERVAL_SECONDS=30
# PREFERENCE_DEBOUNCE_MINUTES=5
